{
  "name": "frameflow",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "setup:tools": "node scripts/setup-tools.mjs",
    "dev": "npm run dev --workspace server",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace server",
    "build:server": "npm run build --workspace server",
    "build:web": "npm run build --workspace client && npm run build --workspace server",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
